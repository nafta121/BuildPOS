# Supabase Configuration (Optional for Production / Real DB)
# In development/preview mode, BuildPOS runs with a persistent in-memory demo store
# populated with realistic Toko Bangunan materials, categories, and initial transactions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
